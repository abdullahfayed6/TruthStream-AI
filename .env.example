# --- API keys ---
NEWSAPI_KEY=your_newsapi_key_here
GNEWS_KEY=your_gnews_key_here
OPENAI_API_KEY=your_openai_key_here

# --- Kafka ---
KAFKA_BOOTSTRAP=kafka:9092
KAFKA_BOOTSTRAP_EXTERNAL=localhost:29092
TOPIC_RAW=news.raw
TOPIC_SCORED=news.scored

# --- Mongo ---
MONGO_URI=mongodb://mongo:27017
MONGO_DB=truthstream
MONGO_COLLECTION=articles_scored

# --- Spark ---
SPARK_MASTER=spark://spark-master:7077
LAKE_PATH=/opt/lake
CHECKPOINT_PATH=/opt/checkpoints

# --- Ingestion ---
POLL_INTERVAL_SECONDS=60
NEWSAPI_QUERY=politics OR election OR breaking
GNEWS_QUERY=politics

# --- Model ---
MODEL_PATH=/opt/models/distilbert-fakenews
MODEL_FALLBACK=true
